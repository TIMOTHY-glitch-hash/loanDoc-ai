# Copy to .env (git-ignored). Loaded by pydantic-settings at import time.

# --- Server ---
API_ENV=development
API_VERSION=0.1.0
# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# --- Agent / LLM provider ---
# Leave empty to run in "agent disabled" mode: the API still serves the contract
# with deterministic stub extractions, which keeps the demo deployable for free.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Underwriting policy ---
# Extracted fields below this confidence are routed to human review.
REVIEW_CONFIDENCE_THRESHOLD=0.85
# Reject uploads larger than this (bytes). Default 10 MiB.
MAX_UPLOAD_BYTES=10485760
