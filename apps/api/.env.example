# Copy to .env (git-ignored). Loaded by pydantic-settings at import time.

# --- Server ---
API_ENV=development
API_VERSION=0.1.0
# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# --- Agent / LLM provider ---
# Leave empty to run in "agent disabled" mode: the API still serves the contract
# with deterministic stub extractions, which keeps the demo deployable for free.
# /api/v1/extract requires a real key: it has no stub path, and returns 503
# rather than pretending to have read the document.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Any OpenAI-compatible gateway. Leave empty for OpenAI. To run on OpenRouter's
# free tier instead:
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_API_KEY=<openrouter key>
#   OPENAI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
#   LLM_STRUCTURED_OUTPUT_METHOD=json_schema
OPENAI_BASE_URL=
# function_calling (OpenAI) | json_schema (most gateway-hosted open models) | json_mode
LLM_STRUCTURED_OUTPUT_METHOD=function_calling
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

# --- Extraction agent ---
# Pages of a PDF are extracted concurrently; cap it for provider rate limits.
EXTRACTION_PAGE_CONCURRENCY=5
# Reject documents with more pages than this before spending any tokens.
EXTRACTION_MAX_PAGES=40

# --- Memo generation ---
# Prose only. The figures come from a deterministic brief, so this cannot move a
# number - it only affects how the sentences read.
MEMO_TEMPERATURE=0.2

# --- Convex (memo persistence) ---
# Deployment URL, e.g. https://your-deployment.convex.cloud. Leave empty to skip
# persistence: /api/v1/generate-memo then returns the memo with persisted=false
# and a warning rather than failing.
CONVEX_URL=
CONVEX_TIMEOUT_SECONDS=10

# --- Underwriting policy ---
# Extracted fields below this confidence are routed to human review.
REVIEW_CONFIDENCE_THRESHOLD=0.85
# Reject uploads larger than this (bytes). Default 10 MiB.
MAX_UPLOAD_BYTES=10485760
